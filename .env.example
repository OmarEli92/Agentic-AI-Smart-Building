## LLM
APP_ENV=development
LLM_PROVIDER=groq
LLM_MODEL=<INSERT_MODEL_NAME>
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
#io uso groq perchè ha meno limiti di utilizzo sui modelli gratuiti
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=
LLM_API_KEY=<INSERT_API_KEY>

#Qui si può configurare il db per la parte della semantica BIM
# la scelta uguale rispetto al progetto iniziale ovvero GRAPHDB e NEO4J
# Semantic backend selected for the application
SEMANTIC_BACKEND=graphdb
# GraphDB
GRAPHDB_URL=http://localhost:7200/
GRAPHDB_REPOSITORY=smartHome
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=
GRAPHDB_ONTOLOGY_PATH=src/resources/ontology/openSmartHome_Donkers_v2.ttl
# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<PASSWORD>
NEO4J_DATABASE=neo4j

#SEMANTIC_MAX_REPAIR_RETRIES=2
SEMANTIC_MAX_EXECUTION_REPAIR_RETRIES=2

# ThingsBoard

THINGSBOARD_POSTGRES_PASSWORD=thingsboard_dev_password
THINGSBOARD_URL=http://localhost:8080
THINGSBOARD_API_KEY=
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant