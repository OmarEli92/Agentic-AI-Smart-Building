## LLM
APP_ENV=development
LLM_PROVIDER=groq
LLM_MODEL=<INSERT_MODEL_NAME>
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
#io uso groq perchè ha meno limiti di utilizzo sui modelli gratuiti
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=
LLM_API_KEY=<INSERT_API_KEY>

#Qui si può configurare il db per la parte della semantica BIM
# la scelta uguale rispetto al progetto iniziale ovvero GRAPHDB e NEO4J
# Semantic backend selected for the application
SEMANTIC_BACKEND=graphdb
# GraphDB
GRAPHDB_URL=http://localhost:7200/
GRAPHDB_REPOSITORY=smartHome
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=
GRAPHDB_ONTOLOGY_PATH=src/resources/ontology/openSmartHome_Donkers_v2.ttl
# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<PASSWORD>
NEO4J_DATABASE=neo4j

#SEMANTIC_MAX_REPAIR_RETRIES=2
SEMANTIC_MAX_EXECUTION_REPAIR_RETRIES=2
ACTUATOR_RESOLUTION_STRATEGY=llm
#ACTUATOR_RESOLUTION_STRATEGY=ontology_profile

EXECUTION_DATABASE_PATH=data/executions.db

# ThingsBoard
THINGSBOARD_POSTGRES_PASSWORD=thingsboard_dev_password
THINGSBOARD_URL=http://localhost:8080
THINGSBOARD_API_KEY=
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant
THINGSBOARD_INTEGRATION=rest
THINGSBOARD_MCP_SSE_URL=http://localhost:8000/sse
THINGSBOARD_MCP_TIMEOUT_SECONDS=30
THINGSBOARD_MCP_TARGET_URL=http://thingsboard:8080
# ThingsBoard actuation mode
THINGSBOARD_ACTUATION_BACKEND=telemetry
#THINGSBOARD_ACTUATION_BACKEND=rpc

# RPC firmware mapping
ACTUATOR_RPC_PROFILE_PATH=resources/config/actuator_rpc_profile.yaml
# HTTP timeout used while waiting for a TWO-WAY RPC
THINGSBOARD_RPC_REQUEST_TIMEOUT_SECONDS=30
#mcp or rest

PROPOSAL_DATABASE_PATH=data/proposals.db
PROPOSAL_TTL_SECONDS=900



LOG_FILE_PATH=logs/agentic_bim_iot.log
LOG_LEVEL=INFO


LOG_FILE_PATH=logs/agentic_bim_iot.log
LOG_LEVEL=INFO

OBSERVABILITY_BACKEND=langfuse

LANGFUSE_PUBLIC_KEY=pk-lf-INCOLLA_LA_TUA
LANGFUSE_SECRET_KEY=sk-lf-INCOLLA_LA_TUA
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0

EVALUATION_FRAMEWORK=none

#Cache

BIM_CACHE_BACKEND=redis
BIM_CACHE_REDIS_URL=redis://:LA_STESSA_PASSWORD_DI_ENV_CACHE@localhost:6380/0
BIM_CACHE_TTL_SECONDS=604800
BIM_CACHE_KEY_PREFIX=agentic-smart-building
BIM_CACHE_VERSION=v1
BIM_CACHE_FAIL_OPEN=true

#Comfort engine
PROACTIVE_COMFORT_ENABLED=true
PROACTIVE_COMFORT_INTERVAL_SECONDS=60
PROACTIVE_COMFORT_ROOMS=kitchen
PROACTIVE_PROPOSAL_COOLDOWN_SECONDS=900
NOTIFICATION_DATABASE_PATH=data/notifications.db

#Streamlit
STREAMLIT_PAGE_TITLE=Agentic Smart Building
STREAMLIT_NOTIFICATION_POLL_SECONDS=5