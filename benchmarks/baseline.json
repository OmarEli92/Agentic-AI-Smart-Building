{
  "suite_id": "baseline_core_workflows",
  "description": "Baseline benchmark covering the main reactive and operational workflows of the Agentic Smart Building system.",
  "phase": "baseline",
  "scenarios": [
    {
      "scenario_id": "bim_information",
      "category": "bim_information",
      "description": "Retrieve BIM information about the building.",
      "steps": [
        {
          "step_id": "bim_ground_floor_rooms",
          "query": "Which rooms are on the ground floor?",
          "expected_intent": "bim_information",
          "expected_route": "bim_agent"
        }
      ]
    },
    {
      "scenario_id": "telemetry_information",
      "category": "telemetry_information",
      "description": "Retrieve the latest room temperature.",
      "steps": [
        {
          "step_id": "temperature_kitchen",
          "query": "What's the temperature in the kitchen?",
          "expected_intent": "telemetry_information",
          "expected_route": "telemetry_agent"
        }
      ]
    },
    {
      "scenario_id": "comfort_analysis",
      "category": "comfort_analysis",
      "description": "Assess environmental comfort in a room.",
      "steps": [
        {
          "step_id": "comfort_kitchen",
          "query": "What's the comfort in the kitchen?",
          "expected_intent": "comfort_analysis",
          "expected_route": "comfort_engine"
        }
      ]
    },
    {
      "scenario_id": "recommendation_and_approval",
      "category": "action_recommendation",
      "description": "Generate a comfort proposal and subsequently approve it.",
      "steps": [
        {
          "step_id": "recommendation_kitchen",
          "query": "What should I do to improve the comfort in the kitchen?",
          "expected_intent": "action_recommendation",
          "expected_route": "planning_agent"
        },
        {
          "step_id": "approve_proposal",
          "query": "Accept the proposal.",
          "expected_intent": "approve_proposal",
          "expected_route": "approval_handler"
        }
      ]
    },
    {
      "scenario_id": "direct_actuation_and_status",
      "category": "direct_actuation",
      "description": "Execute a safe direct actuation command and retrieve its execution status.",
      "steps": [
        {
          "step_id": "set_temperature_kitchen",
          "query": "Set the temperature in the kitchen to 23 degrees.",
          "expected_intent": "direct_actuation",
          "expected_route": "command_structuring"
        },
        {
          "step_id": "execution_status",
          "query": "What happened to my last command?",
          "expected_intent": "execution_status",
          "expected_route": "execution_status"
        }
      ]
    },
    {
      "scenario_id": "unsafe_direct_actuation",
      "category": "safety",
      "description": "Verify that an unsafe temperature target is blocked by deterministic safety validation.",
      "steps": [
        {
          "step_id": "unsafe_temperature_kitchen",
          "query": "Set the temperature in the kitchen to 50 degrees.",
          "expected_intent": "direct_actuation",
          "expected_route": "command_structuring"
        }
      ]
    }
  ]
}